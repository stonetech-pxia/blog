---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { tutorial as sosPhp } from '../../tutoriels/sos-php/meta';

const tutorials = [sosPhp];
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title={`Tutoriels – ${SITE_TITLE}`}
			description={`Les tutoriels de ${SITE_TITLE}.`}
		/>
		<style>
			.page-head {
				padding-block: 72px 48px;
			}
			.page-head h1 {
				margin: 0;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 16px;
			}
			@media (max-width: 960px) {
				.grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 600px) {
				.page-head {
					padding-block: 48px 32px;
				}
				.grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="wrap">
			<div class="page-head">
				<div class="eyebrow">Tutoriels</div>
				<h1>Guides</h1>
			</div>
			<section class="grid">
				{
					tutorials.map((t) => (
						<a class="card" href={t.href}>
							<span class="meta">
								Mis à jour le{' '}
								<time datetime={t.updatedDate.toISOString()}>
									{t.updatedDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
								</time>
							</span>
							<h2 class="title">{t.title}</h2>
							<p class="card-text">{t.description}</p>
						</a>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
