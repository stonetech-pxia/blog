---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import logo from '../assets/stone-cube-logo.svg';
import { Image } from 'astro:assets';

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
		<h1 style="display: flex; justify-content: center;"><Image src={logo} alt={SITE_TITLE} height={65} />Bonjour à tous ! <Image src={logo} alt={SITE_TITLE} height={65} /></h1>
		<p>
			Développeurs, curieux du web et passionnés de tech, bienvenue !
		</p>
		<p>

			Les agents de coding font aujourd'hui beaucoup parler d'eux — et pour cause :
			ils transforment en profondeur notre façon de coder.
		</p>
		<p>
			Dans ce blog, je partage mes astuces concrètes pour tirer le meilleur parti de
			de ces outils au quotidien.
		</p>
		<p>

			Une question ? Une idée de sujet ? N'hésitez pas à laisser un commentaire
			en bas des articles, je lis tout et je vous réponds dès que possible !
		</p>
		</main>
		<Footer />
	</body>
</html>
