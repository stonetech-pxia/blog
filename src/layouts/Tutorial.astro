---
import '../styles/tutoriel.css';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	lead: string;
	tutorial: { title: string; href: string };
	pages: { label: string; href: string }[];
	lang?: 'fr' | 'en';
}

const { title, description, lead, tutorial, pages, lang = 'fr' } = Astro.props;
const current = Astro.url.pathname.replace(/\/?$/, '/');
---

<html lang={lang}>
	<head>
		<BaseHead title={`${title} – ${tutorial.title}`} description={description} />
		<style>
			.post-head {
				padding-block: 72px 32px;
			}
			.post-head h1 {
				margin: 0;
				font-size: clamp(34px, 4.6vw, var(--t-2xl));
				line-height: 1.08;
			}
			.post-head .lede {
				margin-bottom: 0;
			}
			.eyebrow a {
				color: inherit;
			}
			.seg {
				display: inline-flex;
				flex-wrap: wrap;
				gap: 4px;
				margin: 0 0 40px;
				padding: 4px;
				background: var(--surface-2);
				border-radius: var(--r-control);
			}
			.seg a {
				display: inline-flex;
				align-items: center;
				min-height: 40px;
				padding: 0 16px;
				color: var(--ink-muted);
				font-size: var(--t-sm);
				font-weight: 700;
				text-decoration: none;
				border-radius: 6px;
			}
			.seg a:hover {
				color: var(--ink);
			}
			.seg a[aria-current='page'] {
				color: var(--ink);
				background: var(--surface);
				box-shadow: 0 0 0 1px var(--divider);
			}
			@media (max-width: 600px) {
				.post-head {
					padding-block: 48px 24px;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="prose">
				<div class="post-head">
					<div class="eyebrow">
						<a href="/tutoriels/">{lang === 'en' ? 'Tutorials' : 'Tutoriels'}</a> · {tutorial.title}
					</div>
					<h1>{title}</h1>
					<p class="lede">{lead}</p>
				</div>
				<nav class="seg" aria-label={tutorial.title}>
					{
						pages.map((p) => (
							<a href={p.href} aria-current={p.href === current ? 'page' : undefined}>
								{p.label}
							</a>
						))
					}
				</nav>
				<div class="tuto">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
